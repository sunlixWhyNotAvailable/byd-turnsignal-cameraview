<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.BYDAUTO_LIGHT_SET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <queries>
        <package android:name="com.byd.appstartmanagement" />
        <package android:name="com.byd.turnsignalguard.capture" />
    </queries>

    <application
        android:allowBackup="false"
        android:hasCode="true"
        android:icon="@drawable/byd_extend_mark"
        android:label="BYD Extend"
        android:name="com.byd.extend.TurnSignalGuardApplication"
        android:theme="@style/Theme.BydExtend">

        <activity
            android:name="com.byd.extend.CameraProbeActivity"
            android:autoRemoveFromRecents="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape" />

        <!-- Preserve the launcher component already pinned by Extend 0.53.0 users. -->
        <activity-alias
            android:name="com.byd.turnsignalguard.capture.CameraProbeActivity"
            android:targetActivity="com.byd.extend.CameraProbeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name="com.byd.extend.CameraHelperService"
            android:exported="false"
            android:foregroundServiceType="location"
            android:stopWithTask="false" />

        <service
            android:name="com.byd.extend.WeatherRefreshAccessibilityService"
            android:exported="true"
            android:label="@string/weather_accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/weather_refresh_accessibility_service" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>

        <receiver
            android:name="com.byd.extend.GuardRecoveryReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="9900">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.byd.extend.GuardWatchdogReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name="com.byd.extend.ShellRecoveryReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.byd.extend.action.SHELL_RECOVERY" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
